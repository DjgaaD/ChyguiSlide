<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.BiblePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ChyguiSlide.Converters"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Margin="16,12">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>

        <!-- Режим списков -->
        <Grid
            ColumnSpacing="12"
            Visibility="{Binding IsListPickerLayout, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding TestamentFilterItems}"
                        SelectedItem="{Binding SelectedTestamentFilter, Mode=TwoWay}"
                        DisplayMemberPath="Title" />
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Row="1"
                        PlaceholderText="2пар 15 8 · Екк 11 10 · текст…"
                        QuerySubmitted="OnSearchSubmitted"
                        TextChanged="OnSearchTextChanged" />
                    <ListView
                        Grid.Row="2"
                        ItemsSource="{Binding Books}"
                        SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="4,6"
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="8">
                <ListView
                    x:Name="ChapterList"
                    ItemsSource="{Binding Chapters}"
                    SelectionChanged="OnChapterSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="16"
                                Text="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="8">
                <Grid>
                    <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,0,4,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding SelectionSummary}" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ProgressRing Width="22" Height="22" IsActive="{Binding IsBusy}" />
                                <Button
                                    Content="Показать на экране"
                                    Command="{Binding StartProjectionCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                        <ListView
                            x:Name="VerseList"
                            Grid.Row="1"
                            ItemsSource="{Binding Verses}"
                            SelectedItem="{Binding SelectedVerse, Mode=TwoWay}"
                            SelectionMode="Single"
                            ItemContainerStyle="{StaticResource SelectableCardListViewItemStyle}"
                            ItemTemplate="{StaticResource SelectableCardSelectedTemplate}" />
                    </Grid>

                    <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="8,4"
                            FontWeight="SemiBold"
                            Text="Результаты поиска" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding SearchResults}"
                            SelectionChanged="OnSearchResultSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Padding="4,6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Reference}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Режим таблицы -->
        <Grid
            ColumnSpacing="8"
            Visibility="{Binding IsGridPickerLayout, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="4">
                <Grid>
                    <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="4,2"
                            FontWeight="SemiBold"
                            Text="{Binding SelectionSummary}" />
                        <ListView
                            x:Name="GridVerseTextList"
                            Grid.Row="1"
                            ItemsSource="{Binding Verses}"
                            SelectedItem="{Binding SelectedVerse, Mode=TwoWay}"
                            SelectionMode="Single"
                            ItemContainerStyle="{StaticResource SelectableCardListViewItemStyle}"
                            ItemTemplate="{StaticResource SelectableCardSelectedTemplate}" />
                    </Grid>

                    <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="8,4"
                            FontWeight="SemiBold"
                            Text="Результаты поиска" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding SearchResults}"
                            SelectionChanged="OnSearchResultSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Padding="4,6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Reference}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="GridSearchBox"
                        PlaceholderText="2пар 15 8 · Екк 11 10 · текст…"
                        QuerySubmitted="OnSearchSubmitted"
                        TextChanged="OnSearchTextChanged" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding TestamentFilterItems}"
                        SelectedItem="{Binding SelectedTestamentFilter, Mode=TwoWay}"
                        DisplayMemberPath="Title" />
                    <ProgressRing
                        Grid.Column="2"
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        IsActive="{Binding IsBusy}" />
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Content="Показать на экране"
                        Command="{Binding StartProjectionCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="0">
                    <Grid x:Name="BookTable" />
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="0">
                        <Grid x:Name="ChapterTable" />
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="0">
                        <Grid x:Name="VerseTable" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
