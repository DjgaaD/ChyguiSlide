<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ChyguiSlide.Converters"
    xmlns:models="using:ChyguiSlide.Data.Entities"
    xmlns:vm="using:ChyguiSlide.ViewModels"
    xmlns:icons="using:ChyguiSlide.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BoolToAccentBorderBrushConverter x:Key="BoolToAccentBorderBrushConverter" />
        <converters:BoolToAccentBorderThicknessConverter x:Key="BoolToAccentBorderThicknessConverter" />
        <converters:TextAlignmentToBrushConverter x:Key="TextAlignmentToBrushConverter" />
        <converters:TextAlignmentToBorderBrushConverter x:Key="TextAlignmentToBorderBrushConverter" />
        <converters:TextAlignmentToBorderThicknessConverter x:Key="TextAlignmentToBorderThicknessConverter" />

        <DataTemplate x:Key="SettingsNavItemTemplate" x:DataType="vm:SettingsNavItem">
            <NavigationViewItem Tag="{x:Bind Section}">
                <NavigationViewItem.Content>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:LucideIcon
                            Kind="{x:Bind Icon}"
                            Size="18"
                            VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </NavigationViewItem.Content>
            </NavigationViewItem>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,20,24,8" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Настройки" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Параметры трансляции, камеры, оформления, горячих клавиш, резервных копий и сведения о проекте." />
        </StackPanel>

        <NavigationView
            x:Name="SettingsNav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="220"
            MenuItemsSource="{Binding SettingsSections}"
            MenuItemTemplate="{StaticResource SettingsNavItemTemplate}"
            SelectedItem="{Binding SelectedSettingsSection, Mode=TwoWay}"
            SelectionChanged="OnSettingsSectionChanged">
            <ScrollViewer Padding="8,0,24,24">
                <Grid>
                    <!-- Трансляция -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsProjectionSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Тема интерфейса" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Светлая или тёмная тема окон программы (не фон трансляции)." />
                                </StackPanel>
                                <ComboBox
                                    Header="Тема"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding AppUiThemeOptions}"
                                    SelectedItem="{Binding SelectedAppUiTheme, Mode=TwoWay}"
                                    DisplayMemberPath="Title" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedAppUiTheme.Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Экран трансляции" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Выберите монитор для окна проекции. Если экран не выбран, используется основной." />
                                </StackPanel>
                                <ComboBox
                                    Header="Экран"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Автоматически (основной)"
                                    ItemsSource="{Binding AvailableDisplays}"
                                    SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}"
                                    IsEnabled="{Binding IsLoadingDisplays, Converter={StaticResource BoolNegationConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Обновить список" Command="{Binding RefreshDisplaysCommand}" />
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        IsActive="{Binding IsLoadingDisplays}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Перенос текста" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Выберите, как длинные строки песни размещаются на слайде." />
                                </StackPanel>

                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TextLayoutOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TextLayoutOptionItem">
                                            <Button
                                                Width="260"
                                                Margin="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnTextLayoutOptionClick"
                                                Tag="{x:Bind Mode}">
                                                <Border
                                                    MinHeight="240"
                                                    Padding="12"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBorderBrushConverter}}"
                                                    BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBorderThicknessConverter}}"
                                                    CornerRadius="10">
                                                    <Grid RowSpacing="10">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <StackPanel Grid.Row="0" Spacing="2">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind Description}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>

                                                        <Border
                                                            Grid.Row="1"
                                                            Background="#1A000000"
                                                            CornerRadius="6"
                                                            Padding="8"
                                                            VerticalAlignment="Stretch">
                                                            <StackPanel
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Stretch"
                                                                Spacing="2">
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine1}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine2}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine3}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine4}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap"
                                                                    Visibility="{x:Bind ShowExtraLines, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine5}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap"
                                                                    Visibility="{x:Bind ShowExtraLines, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine6}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap"
                                                                    Visibility="{x:Bind ShowExtraLines, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <icons:LucideIcon
                                                            Grid.Row="2"
                                                            Kind="check"
                                                            Size="16"
                                                            HorizontalAlignment="Right"
                                                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Подпись стиха Библии" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Показывать ссылку на книгу, главу и стих (например «Быт 1:12») на экране трансляции." />
                                </StackPanel>
                                <CheckBox
                                    Content="Отображать подпись книги, главы и стиха"
                                    IsChecked="{Binding ShowBibleReference, Mode=TwoWay}" />
                                <ComboBox
                                    Header="Положение относительно текста"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding BibleReferencePlacementOptions}"
                                    SelectedItem="{Binding SelectedBibleReferencePlacement, Mode=TwoWay}"
                                    DisplayMemberPath="Title"
                                    IsEnabled="{Binding ShowBibleReference}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <TextBlock VerticalAlignment="Center" Text="Выравнивание:" />
                                    <RadioButton Content="Слева" IsChecked="{Binding IsBibleRefAlignLeft, Mode=TwoWay}" IsEnabled="{Binding ShowBibleReference}" />
                                    <RadioButton Content="По центру" IsChecked="{Binding IsBibleRefAlignCenter, Mode=TwoWay}" IsEnabled="{Binding ShowBibleReference}" />
                                    <RadioButton Content="Справа" IsChecked="{Binding IsBibleRefAlignRight, Mode=TwoWay}" IsEnabled="{Binding ShowBibleReference}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Камера -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsCameraSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Видеопоток с телефона" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="IP и порт Android-устройства для фонового видео. По умолчанию порт 5000." />
                                </StackPanel>
                                <TextBox
                                    Header="IP адрес"
                                    PlaceholderText="192.168.1.100"
                                    Text="{Binding CameraHost, Mode=TwoWay}" />
                                <controls:NumberBox
                                    Header="Порт"
                                    Minimum="1"
                                    Maximum="65535"
                                    Value="{Binding CameraPort, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Стили -->
                    <Grid
                        ColumnSpacing="20"
                        Visibility="{Binding IsThemesSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Стили оформления" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding CreateCommand}" ToolTipService.ToolTip="Создать стиль">
                                        <icons:LucideIcon Kind="plus" Size="18" />
                                    </Button>
                                    <Button
                                        Command="{Binding SaveCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Сохранить стиль">
                                        <icons:LucideIcon Kind="save" Size="18" />
                                    </Button>
                                    <Button Command="{Binding DeleteCommand}" ToolTipService.ToolTip="Удалить стиль">
                                        <icons:LucideIcon Kind="trash-2" Size="18" />
                                    </Button>
                                </StackPanel>
                                <ListView
                                    ItemsSource="{Binding Presets}"
                                    SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    MaxHeight="420">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ThemePreset">
                                            <TextBlock Text="{x:Bind Name}" Padding="0,4" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Редактор стиля" />
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="12">
                                        <TextBox Header="Название" Text="{Binding PresetName, Mode=TwoWay}" />
                                        <TextBox
                                            Header="Шрифт"
                                            PlaceholderText="Segoe UI"
                                            Text="{Binding FontFamily, Mode=TwoWay}" />
                                        <ToggleSwitch
                                            Header="Жирный шрифт"
                                            OffContent="Обычный"
                                            OnContent="Жирный"
                                            IsOn="{Binding IsBold, Mode=TwoWay}" />
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Выравнивание" Style="{ThemeResource CaptionTextBlockStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="По левому краю"
                                                    Command="{Binding SetTextAlignmentCommand}"
                                                    CommandParameter="Left"
                                                    Background="{Binding TextAlignment, Converter={StaticResource TextAlignmentToBrushConverter}, ConverterParameter=Left}"
                                                    BorderBrush="{Binding TextAlignment, Converter={StaticResource TextAlignmentToBorderBrushConverter}, ConverterParameter=Left}"
                                                    BorderThickness="{Binding TextAlignment, Converter={StaticResource TextAlignmentToBorderThicknessConverter}, ConverterParameter=Left}">
                                                    <icons:LucideIcon Kind="text-align-start" Size="18" />
                                                </Button>
                                                <Button
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="По центру"
                                                    Command="{Binding SetTextAlignmentCommand}"
                                                    CommandParameter="Center"
                                                    Background="{Binding TextAlignment, Converter={StaticResource TextAlignmentToBrushConverter}, ConverterParameter=Center}"
                                                    BorderBrush="{Binding TextAlignment, Converter={StaticResource TextAlignmentToBorderBrushConverter}, ConverterParameter=Center}"
                                                    BorderThickness="{Binding TextAlignment, Converter={StaticResource TextAlignmentToBorderThicknessConverter}, ConverterParameter=Center}">
                                                    <icons:LucideIcon Kind="text-align-center" Size="18" />
                                                </Button>
                                                <Button
                                                    Width="40"
                                                    Height="40"
                                                    Padding="0"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="По правому краю"
                                                    Command="{Binding SetTextAlignmentCommand}"
                                                    CommandParameter="Right"
                                                    Background="{Binding TextAlignment, Converter={StaticResource TextAlignmentToBrushConverter}, ConverterParameter=Right}"
                                                    BorderBrush="{Binding TextAlignment, Converter={StaticResource TextAlignmentToBorderBrushConverter}, ConverterParameter=Right}"
                                                    BorderThickness="{Binding TextAlignment, Converter={StaticResource TextAlignmentToBorderThicknessConverter}, ConverterParameter=Right}">
                                                    <icons:LucideIcon Kind="text-align-end" Size="18" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox
                                            Header="Анимация смены слайда"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding SectionTransitionOptions}"
                                            SelectedItem="{Binding SelectedSectionTransition, Mode=TwoWay}"
                                            DisplayMemberPath="Title" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding SelectedSectionTransition.Description}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Обои (MP4 / изображение)" />
                                            <ToggleSwitch
                                                Header="Отдельные обои для песен и Библии"
                                                IsOn="{Binding UseSeparateBackgrounds, Mode=TwoWay}" />
                                            <ComboBox
                                                Header="Как выбирать фон"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding BackgroundPickModeOptions}"
                                                SelectedItem="{Binding SelectedBackgroundPickMode, Mode=TwoWay}"
                                                DisplayMemberPath="Title" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SelectedBackgroundPickMode.Description}"
                                                TextWrapping="Wrap" />
                                            <ComboBox
                                                Header="Набор обоев"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding WallpaperPoolOptions}"
                                                SelectedItem="{Binding SelectedWallpaperPool, Mode=TwoWay}"
                                                DisplayMemberPath="Title"
                                                Visibility="{Binding IsWallpaperPoolSelectorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ListView
                                                MinHeight="120"
                                                MaxHeight="200"
                                                ItemsSource="{Binding EditingPoolWallpapers}"
                                                SelectedItem="{Binding SelectedWallpaper, Mode=TwoWay}"
                                                SelectionMode="Single">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding WallpaperEmptyHint}"
                                                Visibility="{Binding IsEditingPoolEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    Content="Добавить…"
                                                    Command="{Binding AddWallpaperCommand}" />
                                                <Button
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    Content="Удалить"
                                                    Command="{Binding RemoveWallpaperCommand}" />
                                                <Button
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Stretch"
                                                    Content="Выбрать"
                                                    Command="{Binding SelectWallpaperAsFixedCommand}"
                                                    Visibility="{Binding IsFixedWallpaperPickMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </StackPanel>
                                        <ToggleSwitch
                                            Header="Циклическое воспроизведение фона"
                                            IsOn="{Binding LoopBackgroundMedia, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="12">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Header="Цвет текста" Text="{Binding PrimaryColor, Mode=TwoWay}" />
                                            <Button
                                                Grid.Column="1"
                                                Width="40"
                                                Height="32"
                                                Margin="0,24,0,0"
                                                Padding="0"
                                                VerticalAlignment="Top"
                                                Background="{Binding PrimaryColor, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{ThemeResource StrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Click="OnPickPrimaryColorClicked"
                                                ToolTipService.ToolTip="Палитра" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Header="Фоновый цвет" Text="{Binding BackgroundColor, Mode=TwoWay}" />
                                            <Button
                                                Grid.Column="1"
                                                Width="40"
                                                Height="32"
                                                Margin="0,24,0,0"
                                                Padding="0"
                                                VerticalAlignment="Top"
                                                Background="{Binding BackgroundColor, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{ThemeResource StrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Click="OnPickBackgroundColorClicked"
                                                ToolTipService.ToolTip="Палитра" />
                                        </Grid>
                                        <ToggleSwitch Header="Обводка текста" IsOn="{Binding TextOutlineEnabled, Mode=TwoWay}" />
                                        <NumberBox
                                            Header="Размер обводки"
                                            Minimum="0"
                                            Maximum="20"
                                            SmallChange="0.5"
                                            LargeChange="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding TextOutlineThickness, Mode=TwoWay}"
                                            IsEnabled="{Binding TextOutlineEnabled}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Header="Цвет обводки"
                                                Text="{Binding TextOutlineColor, Mode=TwoWay}"
                                                IsEnabled="{Binding TextOutlineEnabled}" />
                                            <Button
                                                Grid.Column="1"
                                                Width="40"
                                                Height="32"
                                                Margin="0,24,0,0"
                                                Padding="0"
                                                VerticalAlignment="Top"
                                                Background="{Binding TextOutlineColor, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{ThemeResource StrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                IsEnabled="{Binding TextOutlineEnabled}"
                                                Click="OnPickOutlineColorClicked"
                                                ToolTipService.ToolTip="Палитра" />
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Прозрачность контура" />
                                            <Slider
                                                Minimum="0"
                                                Maximum="100"
                                                StepFrequency="1"
                                                Value="{Binding TextOutlineOpacityPercent, Mode=TwoWay}"
                                                IsEnabled="{Binding TextOutlineEnabled}" />
                                        </StackPanel>
                                        <Border
                                            Background="{Binding BackgroundColor, Converter={StaticResource HexToBrushConverter}}"
                                            BorderBrush="{ThemeResource StrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="20"
                                            MinHeight="140">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                                    Foreground="{Binding PrimaryColor, Converter={StaticResource HexToBrushConverter}}"
                                                    Text="{Binding PresetName}" />
                                                <TextBlock
                                                    FontSize="16"
                                                    Foreground="{Binding PrimaryColor, Converter={StaticResource HexToBrushConverter}}"
                                                    TextWrapping="Wrap"
                                                    Text="Господь — свет мой и спасение моё." />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Горячие клавиши -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsHotkeysSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Горячие клавиши" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            Text="Нажмите кнопку клавиши и затем нужную клавишу на клавиатуре. Esc отменяет назначение." />
                                    </StackPanel>
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Content="Сбросить"
                                        Command="{Binding ResetHotkeysCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Hotkeys}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HotkeyBindingItem">
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="14,12"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap"
                                                            Text="{x:Bind Description}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        MinWidth="140"
                                                        Content="{x:Bind KeyDisplay, Mode=OneWay}"
                                                        Command="{x:Bind StartListeningCommand}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Content="Очистить"
                                                        Command="{x:Bind ClearCommand}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Резервные копии / Яндекс.Диск -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsBackupSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Яндекс.Диск" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Копия всей базы песен (catalog.db) на Яндекс.Диск и восстановление. Создайте приложение на oauth.yandex.ru с правами disk.info, disk.read, disk.write." />
                                </StackPanel>

                                <TextBox
                                    Header="Client ID"
                                    PlaceholderText="из oauth.yandex.ru"
                                    Text="{Binding YandexClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Header="OAuth-токен"
                                    PlaceholderText="access_token с страницы Яндекса"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="False"
                                    Text="{Binding YandexAccessToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Header="Папка на Диске"
                                    Text="{Binding YandexFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <NumberBox
                                    Header="Хранить копий (макс.)"
                                    Minimum="1"
                                    Maximum="50"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{Binding YandexMaxCopies, Mode=TwoWay}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Получить токен" Command="{Binding OpenYandexTokenPageCommand}" />
                                    <Button Content="Сохранить" Command="{Binding SaveYandexSettingsCommand}" />
                                    <Button Content="Проверить связь" Command="{Binding TestYandexConnectionCommand}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Content="Создать копию сейчас"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding BackupCatalogCommand}" />
                                    <Button
                                        Content="Копия в папку…"
                                        Command="{Binding BackupCatalogLocalCommand}" />
                                    <Button Content="Обновить список" Command="{Binding RefreshYandexBackupsCommand}" />
                                </StackPanel>

                                <ListView
                                    MaxHeight="280"
                                    ItemsSource="{Binding YandexBackups}"
                                    SelectedItem="{Binding SelectedYandexBackup, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,4" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button
                                    Content="Восстановить выбранную копию"
                                    Click="OnRestoreYandexBackupClicked" />

                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True"
                                        Text="{Binding BackupStatusMessage}" />
                                </StackPanel>
                                <ProgressRing
                                    Width="28"
                                    Height="28"
                                    IsActive="{Binding IsBackupBusy}"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Расписание" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Автоматическая копия в выбранные дни и время, пока программа запущена. Если время пропущено — копия не создаётся." />
                                </StackPanel>

                                <ToggleSwitch
                                    Header="Автоматическое копирование"
                                    IsOn="{Binding AutoBackupEnabled, Mode=TwoWay}" />

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Дни" />
                                    <ItemsControl ItemsSource="{Binding AutoBackupDayOptions}" IsEnabled="{Binding AutoBackupEnabled}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BackupScheduleDayOption">
                                                <CheckBox
                                                    Content="{x:Bind Title}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    MinWidth="48" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TimePicker
                                    Header="Время"
                                    ClockIdentifier="24HourClock"
                                    MinuteIncrement="1"
                                    SelectedTime="{Binding AutoBackupTime, Mode=TwoWay}"
                                    IsEnabled="{Binding AutoBackupEnabled}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- О нас -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsAboutSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="О нас" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding AppProductLabel}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{Binding IsBetaChannel, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Text="Бета-сборка: возможны изменения и доработки." />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Сведения о церкви и контакты разработчика." />
                                    <Button
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Content="Проверить обновления"
                                        Command="{Binding CheckForUpdatesCommand}" />
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        FontWeight="SemiBold"
                                        Text="Церковь Евангельских Христиан Баптистов Т9" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="г. Ростов-на-Дону, улица Труда 9" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Контакты разработчика" FontWeight="SemiBold" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="DjgaaD@ya.ru" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Page>
