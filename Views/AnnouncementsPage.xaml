<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.AnnouncementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ChyguiSlide.Converters"
    xmlns:icons="using:ChyguiSlide.Controls"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Margin="24,16,24,16" RowSpacing="12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="12"
            Padding="16">
            <StackPanel Spacing="12">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    VerticalAlignment="Center"
                    PlaceholderText="Поиск по заголовку или тексту…"
                    QuerySubmitted="OnSearchBoxQuerySubmitted"
                    TextChanged="OnSearchBoxTextChanged" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="OnAddToQuickPlaylistClicked"
                        Command="{Binding AddToQuickPlaylistCommand}"
                        Visibility="{Binding ShowAddToQuickPlaylistButton, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="list" Size="16" />
                            <TextBlock Text="В плейлист" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding ShowInQuickPlaylistBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="check" Size="16" />
                            <TextBlock Text="В плейлисте" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Click="OnQuickAnnouncementClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="megaphone" Size="16" />
                            <TextBlock Text="Быстрое объявление" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Click="OnCreateAnnouncementClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="plus" Size="16" />
                            <TextBlock Text="Добавить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Click="OnEditAnnouncementClicked"
                        IsEnabled="{Binding HasSelectedAnnouncement}"
                        Visibility="{Binding HasSelectedAnnouncement, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="pencil" Size="16" />
                            <TextBlock Text="Изменить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Click="OnDeleteAnnouncementClicked"
                        IsEnabled="{Binding HasSelectedAnnouncement}"
                        Visibility="{Binding HasSelectedAnnouncement, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="trash-2" Size="16" />
                            <TextBlock Text="Удалить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{Binding TogglePinCommand}"
                        IsEnabled="{Binding HasSelectedAnnouncement}"
                        Visibility="{Binding HasSelectedAnnouncement, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="pin" Size="16" />
                            <TextBlock Text="Закрепить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ProgressRing
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        IsActive="{Binding IsBusy}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="12">
            <ListView
                x:Name="AnnouncementListView"
                Margin="8"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedAnnouncement, Mode=TwoWay}"
                SelectionMode="Single"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{ThemeResource StrokeColorDefaultBrush}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:LucideIcon
                                    Kind="pin"
                                    Size="14"
                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Text="{Binding Content}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="12">
            <Grid Margin="16">
                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Выберите объявление, чтобы увидеть слайды."
                    Visibility="{Binding SelectedAnnouncement, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />

                <Grid Visibility="{Binding SelectedAnnouncement, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Margin="0,0,0,12"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{Binding SelectedAnnouncement.Title}" />
                        <Button
                            Content="Показать на экране"
                            Command="{Binding StartProjectionCommand}" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        ItemContainerStyle="{StaticResource SelectableCardListViewItemStyle}"
                        ItemTemplate="{StaticResource SelectableCardSelectedTemplate}"
                        ItemsSource="{Binding SlidesPreview}"
                        SelectedItem="{Binding SelectedSlidePreview, Mode=TwoWay}"
                        SelectionMode="Single" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
