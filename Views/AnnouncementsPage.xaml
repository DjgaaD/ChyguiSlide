<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.AnnouncementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ChyguiSlide.Converters"
    xmlns:icons="using:ChyguiSlide.Controls"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Margin="24,16" RowSpacing="12" ColumnSpacing="12">
        <Grid.Resources>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Объявления" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Быстрые — набрать и показать. Постоянные — сохранить и использовать снова. Пустая строка в тексте = новый слайд."
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Список постоянных -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="12"
            Padding="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Постоянные" />
                    <Button
                        Content="+"
                        ToolTipService.ToolTip="Новое"
                        Command="{Binding NewPermanentCommand}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{Binding IsBusy}" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{Binding PermanentItems}"
                    SelectedItem="{Binding SelectedPermanent, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2" Padding="4,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:LucideIcon
                                        Kind="pin"
                                        Size="12"
                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Content}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Правая колонка: быстрое + редактор -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- Быстрое -->
                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="12"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="Быстрое объявление" />
                        <TextBox
                            Header="Заголовок (необязательно)"
                            PlaceholderText="Например: Собрание молодёжи"
                            Text="{Binding QuickTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Header="Текст"
                            PlaceholderText="Текст объявления. Пустая строка — следующий слайд."
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="120"
                            Text="{Binding QuickContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Показать на экране"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding ShowQuickCommand}" />
                            <Button
                                Content="Сохранить в постоянные"
                                Command="{Binding SaveQuickCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Редактор постоянного -->
                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="12"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="Редактор постоянного" />
                        <TextBox
                            Header="Заголовок"
                            Text="{Binding EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Header="Текст"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="160"
                            Text="{Binding EditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Content="Закрепить вверху списка"
                            IsChecked="{Binding EditIsPinned, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Показать на экране"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding ShowSelectedCommand}" />
                            <Button Content="Сохранить" Command="{Binding SaveSelectedCommand}" />
                            <Button Content="Удалить" Command="{Binding DeleteSelectedCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
