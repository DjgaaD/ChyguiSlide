using System;
using System.Collections.Generic;
using System.Linq;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using Microsoft.UI.Xaml.Media;
using Windows.UI;

namespace GertnerSlide.Views.Dialogs;

public sealed partial class ColorPickerDialog : ContentDialog
{
    public string? SelectedColor { get; private set; }
    
    public string? InitialColor { get; set; }

    private readonly List<SolidColorBrush> _basicColors = new()
    {
        // Первый ряд
        new SolidColorBrush(Color.FromArgb(255, 0, 0, 0)),           // Черный
        new SolidColorBrush(Color.FromArgb(255, 64, 64, 64)),       // Темно-серый
        new SolidColorBrush(Color.FromArgb(255, 128, 0, 0)),        // Темно-красный
        new SolidColorBrush(Color.FromArgb(255, 255, 0, 0)),        // Красный
        new SolidColorBrush(Color.FromArgb(255, 255, 128, 0)),      // Оранжевый
        new SolidColorBrush(Color.FromArgb(255, 255, 255, 0)),       // Желтый
        new SolidColorBrush(Color.FromArgb(255, 0, 128, 0)),        // Зеленый
        new SolidColorBrush(Color.FromArgb(255, 0, 0, 255)),        // Синий
        
        // Второй ряд
        new SolidColorBrush(Color.FromArgb(255, 255, 255, 255)),     // Белый
        new SolidColorBrush(Color.FromArgb(255, 192, 192, 192)),     // Светло-серый
        new SolidColorBrush(Color.FromArgb(255, 128, 64, 0)),       // Коричневый
        new SolidColorBrush(Color.FromArgb(255, 255, 192, 203)),    // Розовый
        new SolidColorBrush(Color.FromArgb(255, 255, 200, 150)),     // Светло-оранжевый
        new SolidColorBrush(Color.FromArgb(255, 255, 255, 224)),     // Кремовый
        new SolidColorBrush(Color.FromArgb(255, 144, 238, 144)),    // Светло-зеленый
        new SolidColorBrush(Color.FromArgb(255, 173, 216, 230)),     // Светло-синий
        
        // Третий ряд (пустые слоты для пользовательских цветов - прозрачные)
        new SolidColorBrush(Colors.Transparent),
        new SolidColorBrush(Colors.Transparent),
        new SolidColorBrush(Colors.Transparent),
        new SolidColorBrush(Colors.Transparent),
        new SolidColorBrush(Colors.Transparent),
        new SolidColorBrush(Colors.Transparent),
        new SolidColorBrush(Colors.Transparent),
        new SolidColorBrush(Colors.Transparent)
    };

    public ColorPickerDialog()
    {
        InitializeComponent();
        ColorSwatchesContainer.ItemsSource = _basicColors;
    }

    private async void OnColorSwatchClicked(object sender, RoutedEventArgs e)
    {
        if (sender is Button button && button.Background is SolidColorBrush brush)
        {
            var color = brush.Color;
            // Если кликнули на пустой слот (прозрачный), открываем расширенный пикер
            if (color.A == 0 || color == Colors.Transparent)
            {
                var advancedDialog = new AdvancedColorPickerDialog
                {
                    XamlRoot = XamlRoot
                };

                var result = await advancedDialog.ShowAsync();
                if (result == ContentDialogResult.Primary && advancedDialog.SelectedColor != null)
                {
                    SelectedColor = advancedDialog.SelectedColor;
                    Hide();
                }
                return;
            }
            
            SelectedColor = $"#{color.R:X2}{color.G:X2}{color.B:X2}";
            Hide();
        }
    }

    private async void OnAdvancedColorPickerClicked(object sender, RoutedEventArgs e)
    {
        var advancedDialog = new AdvancedColorPickerDialog(InitialColor)
        {
            XamlRoot = XamlRoot
        };

        var result = await advancedDialog.ShowAsync();
        if (result == ContentDialogResult.Primary && advancedDialog.SelectedColor != null)
        {
            SelectedColor = advancedDialog.SelectedColor;
            Hide();
        }
    }
}

