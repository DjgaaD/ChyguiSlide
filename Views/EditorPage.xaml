<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:icons="using:ChyguiSlide.Controls"
    xmlns:converters="using:ChyguiSlide.Converters"
    xmlns:enums="using:ChyguiSlide.Data.Enums"
    xmlns:viewModels="using:ChyguiSlide.ViewModels"
    x:Name="EditorPageRoot"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:SectionTypeToStringConverter x:Key="SectionTypeToStringConverter" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel Padding="24" Spacing="24">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Метаданные" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Header="Название"
                            HorizontalAlignment="Stretch"
                            Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Paste="OnTitleTextBoxPaste" />
                        <TextBox
                            Grid.Column="1"
                            Header="Номер"
                            PlaceholderText="Авто"
                            InputScope="Number"
                            HorizontalAlignment="Stretch"
                            Text="{Binding NumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Grid.Column="2"
                            Header="Сборник"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding CollectionOptions}"
                            SelectedItem="{Binding SelectedCollectionOption, Mode=TwoWay}"
                            DisplayMemberPath="Title" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Секции" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding AddSectionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:LucideIcon Kind="plus" Size="16" VerticalAlignment="Center" />
                                <TextBlock Text="Добавить" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RemoveSectionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:LucideIcon Kind="trash-2" Size="16" VerticalAlignment="Center" />
                                <TextBlock Text="Удалить" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding MoveSectionUpCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:LucideIcon Kind="arrow-up" Size="16" VerticalAlignment="Center" />
                                <TextBlock Text="Вверх" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding MoveSectionDownCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:LucideIcon Kind="arrow-down" Size="16" VerticalAlignment="Center" />
                                <TextBlock Text="Вниз" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RepeatChorusAfterVersesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:LucideIcon Kind="form" Size="16" VerticalAlignment="Center" />
                                <TextBlock Text="Припев после куплетов" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SectionContentToSingleLineCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:LucideIcon Kind="text-align-start" Size="16" VerticalAlignment="Center" />
                                <TextBlock Text="Текст в одну строку" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid ColumnSpacing="16" MinHeight="480">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource StrokeColorSecondaryBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Список секций" />
                                <ListView
                                    Grid.Row="1"
                                    MinHeight="420"
                                    ItemsSource="{Binding Sections}"
                                    SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                    ItemContainerStyle="{StaticResource SelectableCardListViewItemStyle}"
                                    ItemTemplate="{StaticResource SelectableCardTitleOnlyTemplate}" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource StrokeColorSecondaryBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{Binding SelectedSection, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                                    Text="Выберите секцию для редактирования." />

                                <ContentControl
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding SelectedSection}"
                                    Visibility="{Binding SelectedSection, Converter={StaticResource NullToVisibilityConverter}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        Grid.Column="0"
                                                        Header="Тип"
                                                        ItemsSource="{Binding DataContext.SectionTypeOptions, ElementName=EditorPageRoot}"
                                                        SelectedItem="{Binding SectionType, Mode=TwoWay}"
                                                        HorizontalAlignment="Stretch"
                                                        MinWidth="160">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="enums:SectionType">
                                                                <TextBlock Text="{Binding Converter={StaticResource SectionTypeToStringConverter}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBox
                                                        Grid.Column="1"
                                                        Header="Заголовок"
                                                        HorizontalAlignment="Stretch"
                                                        Text="{Binding Heading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <TextBox
                                                    Grid.Row="1"
                                                    Header="Текст"
                                                    Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True"
                                                    Height="380"
                                                    HorizontalAlignment="Stretch"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Модалка поверх редактора (второй ContentDialog WinUI не показывает) -->
        <Grid
            Visibility="{Binding IsValidationVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            Background="#99000000">
            <Border
                MaxWidth="440"
                MinWidth="320"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{Binding ValidationTitle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding ValidationError}"
                        TextWrapping="Wrap" />
                    <Button
                        Content="OK"
                        HorizontalAlignment="Right"
                        MinWidth="88"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding DismissValidationCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

