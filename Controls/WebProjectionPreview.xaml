<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ChyguiSlide.Controls.WebProjectionPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ChyguiSlide.Converters"
    IsTabStop="False"
    UseLayoutRounding="False"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="Black">
        <WebView2
            x:Name="WebView"
            DefaultBackgroundColor="Black"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False" />
        <MediaPlayerElement
            x:Name="VideoPlayer"
            AreTransportControlsEnabled="False"
            AutoPlay="True"
            Stretch="Uniform"
            Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibilityConverter}}" />
        <Image
            x:Name="NdiVideoImage"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsNdiVideoMode, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>
