<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.BiblePage"
    x:Name="BiblePageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ChyguiSlide.Converters"
    xmlns:icons="using:ChyguiSlide.Controls"
    xmlns:anim="using:ChyguiSlide.Views.UiAnimation"
    Loaded="OnPageLoaded"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

        <DataTemplate x:Key="ModernBibleBookItemTemplate">
            <Grid Background="{Binding CategoryColorHex, Converter={StaticResource HexToBrushConverter}}">
                <TextBlock
                    Padding="4,3"
                    FontSize="{Binding ModernBookTileFontSize, ElementName=BiblePageRoot}"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Foreground="White"
                    Text="{Binding DisplayName}"
                    ToolTipService.ToolTip="{Binding DisplayName}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ModernSelectableListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="Root" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemHoverBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemHoverBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernBibleBookGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="Root" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="0.16" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="0.24" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBorder.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBorder.BorderThickness" Value="2" />
                                            <Setter Target="HoverOverlay.Opacity" Value="0.16" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBorder.BorderThickness" Value="2" />
                                            <Setter Target="HoverOverlay.Opacity" Value="0.24" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBorder.BorderThickness" Value="2" />
                                            <Setter Target="HoverOverlay.Opacity" Value="0.16" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBorder.BorderThickness" Value="2" />
                                            <Setter Target="HoverOverlay.Opacity" Value="0.24" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Border
                                x:Name="HoverOverlay"
                                Background="White"
                                Opacity="0"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="SelectionBorder"
                                BorderBrush="{ThemeResource ModernAccentBrush}"
                                BorderThickness="0"
                                IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernChapterGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid Width="52" Height="52">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ChapterBg.Opacity" Value="0.18" />
                                            <Setter Target="ChapterBg.Fill" Value="{ThemeResource ModernAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ChapterBg.Opacity" Value="0.28" />
                                            <Setter Target="ChapterBg.Fill" Value="{ThemeResource ModernAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="ChapterBg.Opacity" Value="1" />
                                            <Setter Target="ChapterBg.Fill" Value="{ThemeResource ModernAccentBrush}" />
                                            <Setter Target="ChapterNumber.Foreground" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ChapterBg.Opacity" Value="1" />
                                            <Setter Target="ChapterBg.Fill" Value="{ThemeResource ModernAccentBrush}" />
                                            <Setter Target="ChapterNumber.Foreground" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="ChapterBg.Opacity" Value="1" />
                                            <Setter Target="ChapterBg.Fill" Value="{ThemeResource ModernAccentBrush}" />
                                            <Setter Target="ChapterNumber.Foreground" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ChapterBg.Opacity" Value="1" />
                                            <Setter Target="ChapterBg.Fill" Value="{ThemeResource ModernAccentBrush}" />
                                            <Setter Target="ChapterNumber.Foreground" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ChapterBg.Opacity" Value="1" />
                                            <Setter Target="ChapterBg.Fill" Value="{ThemeResource ModernAccentBrush}" />
                                            <Setter Target="ChapterNumber.Foreground" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Ellipse
                                x:Name="ChapterBg"
                                Fill="{ThemeResource ModernAccentBrush}"
                                Opacity="0" />
                            <TextBlock
                                x:Name="ChapterNumber"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ModernPageBackgroundBrush}">
        <Grid x:Name="ModernRoot" Padding="0" Background="{ThemeResource ModernPageBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17*" />
                <ColumnDefinition Width="46*" />
                <ColumnDefinition Width="37*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource ModernSurfaceBrush}" Padding="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,0,12,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="SearchBoxModern"
                            PlaceholderText="Поиск книги…"
                            QuerySubmitted="OnSearchSubmitted"
                            TextChanged="OnSearchTextChanged" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            IsActive="{Binding IsBusy}" />
                    </Grid>

                    <ScrollViewer
                        x:Name="ModernBooksScroll"
                        Grid.Row="1"
                        HorizontalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Enabled"
                        SizeChanged="OnModernBooksHostSizeChanged">
                        <StackPanel
                            x:Name="ModernBooksHost"
                            HorizontalAlignment="Stretch"
                            Margin="8,0,8,8">
                            <TextBlock
                                x:Name="OldTestamentHeaderModern"
                                Margin="6,4,6,6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                CharacterSpacing="40"
                                Foreground="{ThemeResource ModernMutedBrush}"
                                Text="ВЕТХИЙ ЗАВЕТ" />
                            <GridView
                                x:Name="OldTestamentListModern"
                                Padding="0"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                Loaded="OnModernBookGridLoaded"
                                ItemsSource="{Binding OldTestamentBooks}"
                                SelectionMode="Single"
                                IsItemClickEnabled="False"
                                ItemContainerStyle="{StaticResource ModernBibleBookGridViewItemStyle}"
                                ItemTemplate="{StaticResource ModernBibleBookItemTemplate}"
                                SelectionChanged="OnModernBookSelectionChanged">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid
                                            Orientation="Horizontal"
                                            MaximumRowsOrColumns="3"
                                            ItemWidth="80"
                                            ItemHeight="40" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                            </GridView>
                            <TextBlock
                                x:Name="NewTestamentHeaderModern"
                                Margin="6,10,6,6"
                                FontSize="12"
                                FontWeight="SemiBold"
                                CharacterSpacing="40"
                                Foreground="{ThemeResource ModernMutedBrush}"
                                Text="НОВЫЙ ЗАВЕТ" />
                            <GridView
                                x:Name="NewTestamentListModern"
                                Padding="0"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                Loaded="OnModernBookGridLoaded"
                                ItemsSource="{Binding NewTestamentBooks}"
                                SelectionMode="Single"
                                IsItemClickEnabled="False"
                                ItemContainerStyle="{StaticResource ModernBibleBookGridViewItemStyle}"
                                ItemTemplate="{StaticResource ModernBibleBookItemTemplate}"
                                SelectionChanged="OnModernBookSelectionChanged">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid
                                            Orientation="Horizontal"
                                            MaximumRowsOrColumns="3"
                                            ItemWidth="80"
                                            ItemHeight="40" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                            </GridView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource ModernSlideColumnBackgroundBrush}" Padding="28,22,24,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16" Spacing="6">
                        <TextBlock
                            FontSize="36"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Text="{Binding SelectedBookTitle}" />
                        <TextBlock
                            FontSize="16"
                            Foreground="{ThemeResource ModernMutedBrush}"
                            Text="{Binding SelectedChapterTitle}" />
                    </StackPanel>

                    <GridView
                        x:Name="ChapterGridModern"
                        Grid.Row="1"
                        Margin="0,0,0,16"
                        anim:ItemListAppearance.UseCrossfade="True"
                        ItemsSource="{Binding Chapters}"
                        ItemContainerStyle="{StaticResource ModernChapterGridViewItemStyle}"
                        SelectionMode="Single"
                        SelectionChanged="OnChapterSelectionChanged"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="60" ItemHeight="60" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>

                    <Grid Grid.Row="2">
                        <Grid x:Name="ModernVerseHost" Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <ListView
                                x:Name="VerseListModern"
                                anim:ItemListAppearance.UseCrossfade="True"
                                ItemsSource="{Binding Verses}"
                                SelectedItem="{Binding SelectedVerse, Mode=TwoWay}"
                                SelectionMode="Single"
                                ItemContainerStyle="{StaticResource ModernSelectableListViewItemStyle}"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Enabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="16,12,20,12" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="16"
                                                Foreground="{ThemeResource ModernMutedBrush}"
                                                Text="{Binding VerseNumber}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="20"
                                                LineHeight="28"
                                                TextWrapping="Wrap"
                                                Text="{Binding Text}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Rectangle
                                x:Name="ModernVerseStripe"
                                Width="3"
                                Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Fill="{ThemeResource ModernAccentBrush}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Grid>

                        <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="8,0,8,12"
                                FontSize="16"
                                Foreground="{ThemeResource ModernMutedBrush}"
                                Text="Результаты поиска" />
                            <ListView
                                Grid.Row="1"
                                anim:ItemListAppearance.UseCrossfade="True"
                                ItemsSource="{Binding SearchResults}"
                                SelectionChanged="OnSearchResultSelected"
                                ItemContainerStyle="{StaticResource ModernSelectableListViewItemStyle}"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Enabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="16,12,20,12" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{ThemeResource ModernMutedBrush}"
                                                    Text="{Binding Reference}" />
                                                <TextBlock
                                                    FontSize="20"
                                                    LineHeight="28"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding Text}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource ModernSurfaceBrush}" Padding="20,18,20,16">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Предпросмотр экрана" />
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                        <Grid x:Name="BiblePreviewCanvas" Width="1920" Height="1080" Background="Black">
                            <icons:WebProjectionPreview x:Name="BibleWebPreview" />
                            <TextBlock
                                x:Name="BiblePreviewIdleHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="48"
                                Foreground="{ThemeResource ModernPreviewIdleForegroundBrush}"
                                Text="Выберите стих"
                                Visibility="Collapsed" />
                        </Grid>
                    </Viewbox>
                    <Button
                        Margin="0,16,0,0"
                        Height="48"
                        HorizontalAlignment="Stretch"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Content="Показать на экране"
                        Command="{Binding StartProjectionCommand}"
                        Background="{ThemeResource ModernAccentBrush}"
                        Foreground="White"
                        BorderBrush="{ThemeResource ModernAccentBrush}"
                        CornerRadius="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
