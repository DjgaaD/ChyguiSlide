<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ChyguiSlide.Converters"
    xmlns:models="using:ChyguiSlide.Data.Entities"
    xmlns:vm="using:ChyguiSlide.ViewModels"
    xmlns:icons="using:ChyguiSlide.Controls"
    xmlns:preview="using:ChyguiSlide.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BoolToAccentBorderBrushConverter x:Key="BoolToAccentBorderBrushConverter" />
        <converters:BoolToAccentBorderThicknessConverter x:Key="BoolToAccentBorderThicknessConverter" />
        <converters:TextAlignmentToBrushConverter x:Key="TextAlignmentToBrushConverter" />
        <converters:TextAlignmentToBorderBrushConverter x:Key="TextAlignmentToBorderBrushConverter" />
        <converters:TextAlignmentToBorderThicknessConverter x:Key="TextAlignmentToBorderThicknessConverter" />

        <DataTemplate x:Key="SettingsNavItemTemplate" x:DataType="vm:SettingsNavItem">
            <NavigationViewItem Tag="{x:Bind Section}">
                <NavigationViewItem.Content>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:LucideIcon
                            Kind="{x:Bind Icon}"
                            Size="18"
                            VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </NavigationViewItem.Content>
            </NavigationViewItem>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="SettingsNav"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="220"
            MenuItemsSource="{Binding SettingsSections}"
            MenuItemTemplate="{StaticResource SettingsNavItemTemplate}"
            SelectedItem="{Binding SelectedSettingsSection, Mode=TwoWay}"
            SelectionChanged="OnSettingsSectionChanged">
            <ScrollViewer Padding="8,0,24,24">
                <Grid>
                    <!-- Трансляция -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsProjectionSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Экран трансляции" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Выберите монитор для окна проекции. Если экран не выбран, используется основной." />
                                </StackPanel>
                                <ComboBox
                                    Header="Экран"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Автоматически (основной)"
                                    ItemsSource="{Binding AvailableDisplays}"
                                    SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}"
                                    IsEnabled="{Binding IsLoadingDisplays, Converter={StaticResource BoolNegationConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Обновить список" Command="{Binding RefreshDisplaysCommand}" />
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        IsActive="{Binding IsLoadingDisplays}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Отступы текста на экране" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Фон занимает весь экран, текст размещается внутри заданных отступов. Размер шрифта подстраивается под получившуюся область." />
                                </StackPanel>
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <NumberBox
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Header="Слева (px)"
                                        Minimum="0"
                                        Maximum="4000"
                                        SpinButtonPlacementMode="Inline"
                                        Value="{Binding ProjectionMarginLeft, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Header="Справа (px)"
                                        Minimum="0"
                                        Maximum="4000"
                                        SpinButtonPlacementMode="Inline"
                                        Value="{Binding ProjectionMarginRight, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Header="Сверху (px)"
                                        Minimum="0"
                                        Maximum="4000"
                                        SpinButtonPlacementMode="Inline"
                                        Value="{Binding ProjectionMarginTop, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Header="Снизу (px)"
                                        Minimum="0"
                                        Maximum="4000"
                                        SpinButtonPlacementMode="Inline"
                                        Value="{Binding ProjectionMarginBottom, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding ProjectionContentAreaHint, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Постоянный фон" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="{Binding KeepProjectionBackgroundHint}" />
                                </StackPanel>
                                <CheckBox
                                    Content="Держать фон на экране"
                                    IsEnabled="{Binding CanKeepProjectionBackground}"
                                    IsChecked="{Binding KeepProjectionBackground, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="OBS / стрим (локальная сеть)" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Передаёт только текст слайдов на другой ПК в той же сети. В OBS добавьте источник «Browser Source» с URL ниже, задайте нужный размер (например 1920×200) — перенос строк и размер шрифта подстроятся автоматически. Включите прозрачный фон в OBS." />
                                </StackPanel>
                                <ToggleSwitch
                                    Header="Включить OBS-выход"
                                    IsOn="{Binding ObsStreamEnabled, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="Тёмная подложка под текст"
                                    IsOn="{Binding ObsStreamBackdropEnabled, Mode=TwoWay}"
                                    IsEnabled="{Binding ObsStreamEnabled}" />
                                <NumberBox
                                    Header="Непрозрачность подложки (%)"
                                    Minimum="0"
                                    Maximum="100"
                                    SpinButtonPlacementMode="Inline"
                                    SmallChange="5"
                                    LargeChange="10"
                                    Value="{Binding ObsStreamBackdropOpacity, Mode=TwoWay}"
                                    IsEnabled="{Binding ObsStreamBackdropEnabled}" />
                                <NumberBox
                                    Header="Порт"
                                    Minimum="1024"
                                    Maximum="65535"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{Binding ObsStreamPort, Mode=TwoWay}"
                                    IsEnabled="{Binding ObsStreamEnabled}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="URL для OBS на другом ПК в локальной сети:" />
                                <TextBlock
                                    FontFamily="Consolas,Courier New"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding ObsStreamUrlHint, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Проверка на этом же ПК (не для OBS на другом компьютере):" />
                                <TextBlock
                                    FontFamily="Consolas,Courier New"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding ObsStreamLocalUrlHint, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding ObsStreamShowsLanWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Text="Сервер слушает только localhost. URL выше — ваш LAN IP; если страница не открывается с другого ПК, разрешите «Чугуй Слайды» в брандмауэре Windows для частной сети." />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding ObsStreamStatus}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="При первом запуске Windows может запросить разрешение брандмауэра для приложения — разрешите доступ в локальной сети." />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Перенос текста" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Выберите, как длинные строки песни размещаются на слайде." />
                                </StackPanel>

                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TextLayoutOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TextLayoutOptionItem">
                                            <Button
                                                Width="260"
                                                Margin="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnTextLayoutOptionClick"
                                                Tag="{x:Bind Mode}">
                                                <Border
                                                    MinHeight="240"
                                                    Padding="12"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBorderBrushConverter}}"
                                                    BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBorderThicknessConverter}}"
                                                    CornerRadius="10">
                                                    <Grid RowSpacing="10">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />

                                                        <Border
                                                            Grid.Row="1"
                                                            Background="#1A000000"
                                                            CornerRadius="6"
                                                            Padding="8"
                                                            VerticalAlignment="Stretch">
                                                            <StackPanel
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Stretch"
                                                                Spacing="2">
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine1}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine2}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine3}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine4}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap"
                                                                    Visibility="{x:Bind ShowExtraLines, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine5}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap"
                                                                    Visibility="{x:Bind ShowExtraLines, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock
                                                                    FontSize="{x:Bind PreviewFontSize}"
                                                                    Text="{x:Bind PreviewLine6}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap"
                                                                    Visibility="{x:Bind ShowExtraLines, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Камера -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsCameraSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Видеопоток с телефона" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="IP и порт Android-устройства для фонового видео. По умолчанию порт 5000." />
                                </StackPanel>
                                <TextBox
                                    Header="IP адрес"
                                    PlaceholderText="192.168.1.100"
                                    Text="{Binding CameraHost, Mode=TwoWay}" />
                                <controls:NumberBox
                                    Header="Порт"
                                    Minimum="1"
                                    Maximum="65535"
                                    Value="{Binding CameraPort, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Интерфейс -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Visibility="{Binding IsInterfaceSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="Тема"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource SegmentedTrackStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            Grid.Column="0"
                                            GroupName="AppUiTheme"
                                            Content="Система"
                                            Style="{StaticResource SegmentedRadioStyle}"
                                            IsChecked="{Binding IsAppUiThemeSystem, Mode=TwoWay}" />
                                        <RadioButton
                                            Grid.Column="1"
                                            GroupName="AppUiTheme"
                                            Content="Светлая"
                                            Style="{StaticResource SegmentedRadioStyle}"
                                            IsChecked="{Binding IsAppUiThemeLight, Mode=TwoWay}" />
                                        <RadioButton
                                            Grid.Column="2"
                                            GroupName="AppUiTheme"
                                            Content="Тёмная"
                                            Style="{StaticResource SegmentedRadioStyle}"
                                            IsChecked="{Binding IsAppUiThemeDark, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <CheckBox Content="Спрашивать перед закрытием" IsChecked="{Binding AskBeforeClose, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Стили -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsThemesSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                        <Grid>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Стили оформления" VerticalAlignment="Center" />
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="OnCreatePresetClicked"
                                ToolTipService.ToolTip="Создать стиль">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:LucideIcon Kind="plus" Size="18" />
                                    <TextBlock Text="Новый стиль" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <GridView
                            ItemsSource="{Binding PresetItems}"
                            SelectionMode="None"
                            IsItemClickEnabled="False">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0,0,16,16" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Top" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewItem">
                                                <ContentPresenter
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemePresetListItem">
                                    <StackPanel
                                        Width="300"
                                        Spacing="8"
                                        PointerEntered="OnPresetPreviewPointerEntered"
                                        PointerExited="OnPresetPreviewPointerExited">
                                        <Border
                                            Height="168"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToAccentBorderBrushConverter}}"
                                            BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToAccentBorderThicknessConverter}}"
                                            CornerRadius="12"
                                            Tapped="OnPresetPreviewTapped">
                                            <Grid>
                                                <preview:ThemePresetPreviewCard DataContext="{Binding}" />
                                                <Border
                                                    Width="26"
                                                    Height="26"
                                                    Margin="8"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="13"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Glyph="&#xE73E;" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid ColumnSpacing="4" MinHeight="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <Button
                                                Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnPresetEditClick"
                                                ToolTipService.ToolTip="Редактировать"
                                                Visibility="{Binding ShowEditButton, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <icons:LucideIcon Kind="pencil" Size="14" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                    <!-- Горячие клавиши -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsHotkeysSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Горячие клавиши" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            Text="Нажмите кнопку клавиши и затем нужную клавишу на клавиатуре. Esc отменяет назначение." />
                                    </StackPanel>
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Content="Сбросить"
                                        Command="{Binding ResetHotkeysCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Hotkeys}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HotkeyBindingItem">
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="14,12"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap"
                                                            Text="{x:Bind Description}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        MinWidth="140"
                                                        Content="{x:Bind KeyDisplay, Mode=OneWay}"
                                                        Command="{x:Bind StartListeningCommand}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Content="Очистить"
                                                        Command="{x:Bind ClearCommand}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Резервные копии / Яндекс.Диск -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsBackupSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Яндекс.Диск" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Копия всей базы песен (catalog.db) на Яндекс.Диск и восстановление. Создайте приложение на oauth.yandex.ru с правами disk.info, disk.read, disk.write." />
                                </StackPanel>

                                <TextBox
                                    Header="Client ID"
                                    PlaceholderText="из oauth.yandex.ru"
                                    Text="{Binding YandexClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Header="OAuth-токен"
                                    PlaceholderText="access_token с страницы Яндекса"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="False"
                                    Text="{Binding YandexAccessToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Header="Папка на Диске"
                                    Text="{Binding YandexFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <NumberBox
                                    Header="Хранить копий (макс.)"
                                    Minimum="1"
                                    Maximum="50"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{Binding YandexMaxCopies, Mode=TwoWay}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Получить токен" Command="{Binding OpenYandexTokenPageCommand}" />
                                    <Button Content="Сохранить" Command="{Binding SaveYandexSettingsCommand}" />
                                    <Button Content="Проверить связь" Command="{Binding TestYandexConnectionCommand}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Content="Создать копию сейчас"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding BackupCatalogCommand}" />
                                    <Button
                                        Content="Копия в папку…"
                                        Command="{Binding BackupCatalogLocalCommand}" />
                                    <Button
                                        Content="Восстановить из папки…"
                                        Click="OnRestoreLocalBackupClicked" />
                                    <Button Content="Обновить список" Command="{Binding RefreshYandexBackupsCommand}" />
                                </StackPanel>

                                <ListView
                                    MaxHeight="280"
                                    ItemsSource="{Binding YandexBackups}"
                                    SelectedItem="{Binding SelectedYandexBackup, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,4" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button
                                    Content="Восстановить выбранную копию"
                                    Click="OnRestoreYandexBackupClicked" />

                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True"
                                        Text="{Binding BackupStatusMessage}" />
                                </StackPanel>
                                <ProgressRing
                                    Width="28"
                                    Height="28"
                                    IsActive="{Binding IsBackupBusy}"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Расписание" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Автоматическая копия в выбранные дни и время, пока программа запущена. Если время пропущено — копия не создаётся." />
                                </StackPanel>

                                <ToggleSwitch
                                    Header="Автоматическое копирование"
                                    IsOn="{Binding AutoBackupEnabled, Mode=TwoWay}" />

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Дни" />
                                    <ItemsControl ItemsSource="{Binding AutoBackupDayOptions}" IsEnabled="{Binding AutoBackupEnabled}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BackupScheduleDayOption">
                                                <CheckBox
                                                    Content="{x:Bind Title}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    MinWidth="48" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TimePicker
                                    Header="Время"
                                    ClockIdentifier="24HourClock"
                                    MinuteIncrement="1"
                                    SelectedTime="{Binding AutoBackupTime, Mode=TwoWay}"
                                    IsEnabled="{Binding AutoBackupEnabled}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Логи -->
                    <StackPanel
                        Spacing="12"
                        Visibility="{Binding IsLogsSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Логи приложения" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="Просмотр и сохранение логов приложения для диагностики проблем." />
                                <TextBlock
                                    Text="{x:Bind LogsViewModel.StatusMessage, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Visibility="{x:Bind LogsViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                            <ScrollViewer MaxHeight="480">
                                <ItemsControl ItemsSource="{x:Bind LogsViewModel.Logs, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="{Binding}"
                                                FontFamily="Consolas,Courier New"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="12">
                            <Button
                                Content="Очистить"
                                Command="{x:Bind LogsViewModel.ClearCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Копировать" Command="{x:Bind LogsViewModel.CopyCommand}" />
                            <Button Content="Сохранить в файл" Command="{x:Bind LogsViewModel.SaveCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- О нас -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsAboutSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="О нас" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding AppProductLabel}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{Binding IsBetaChannel, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Text="Бета-сборка: возможны изменения и доработки." />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Сведения о церкви и контакты разработчика." />
                                    <Button
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Content="Проверить обновления"
                                        Command="{Binding CheckForUpdatesCommand}" />
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        FontWeight="SemiBold"
                                        Text="Церковь Евангельских Христиан Баптистов Т9" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="г. Ростов-на-Дону, улица Труда 9" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Контакты разработчика" FontWeight="SemiBold" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="DjgaaD@ya.ru" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Page>
