<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.AnnouncementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ChyguiSlide.Converters"
    xmlns:icons="using:ChyguiSlide.Controls"
    xmlns:anim="using:ChyguiSlide.Views.UiAnimation"
    Loaded="OnPageLoaded"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ModernSelectableListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="Root" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemHoverBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemHoverBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ModernItemSelectedBackgroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ModernPageBackgroundBrush}">
        <Grid x:Name="ModernRoot" Padding="0" Background="{ThemeResource ModernPageBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17*" />
                <ColumnDefinition Width="46*" />
                <ColumnDefinition Width="37*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource ModernSurfaceBrush}" Padding="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,0,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            CharacterSpacing="40"
                            Foreground="{ThemeResource ModernMutedBrush}"
                            VerticalAlignment="Center"
                            Text="ОБЪЯВЛЕНИЯ" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            IsActive="{Binding IsBusy}" />
                    </Grid>

                    <AutoSuggestBox
                        x:Name="SearchBoxModern"
                        Grid.Row="1"
                        Margin="16,0,16,10"
                        PlaceholderText="Поиск…"
                        QuerySubmitted="OnSearchBoxQuerySubmitted"
                        TextChanged="OnSearchBoxTextChanged" />

                    <Grid Grid.Row="2" Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DropDownButton
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="4,6"
                            Background="Transparent"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:LucideIcon Kind="plus" Size="16" />
                                <TextBlock FontSize="13" VerticalAlignment="Center" Text="Объявление" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Добавить" Click="OnCreateAnnouncementClicked" />
                                    <MenuFlyoutSeparator Visibility="{Binding HasSelectedAnnouncement, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuFlyoutItem
                                        Text="Изменить"
                                        Click="OnEditAnnouncementClicked"
                                        IsEnabled="{Binding HasSelectedAnnouncement}"
                                        Visibility="{Binding HasSelectedAnnouncement, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuFlyoutItem
                                        Text="Удалить"
                                        Click="OnDeleteAnnouncementClicked"
                                        IsEnabled="{Binding HasSelectedAnnouncement}"
                                        Visibility="{Binding HasSelectedAnnouncement, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuFlyoutItem
                                        Text="Закрепить"
                                        Command="{Binding TogglePinCommand}"
                                        IsEnabled="{Binding HasSelectedAnnouncement}"
                                        Visibility="{Binding HasSelectedAnnouncement, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="4,6"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnQuickAnnouncementClicked">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:LucideIcon Kind="megaphone" Size="16" />
                                <TextBlock FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" Text="Быстрое" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="4,6"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnAddToQuickPlaylistClicked"
                            Command="{Binding AddToQuickPlaylistCommand}"
                            Visibility="{Binding ShowAddToQuickPlaylistButton, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:LucideIcon Kind="list" Size="16" />
                                <TextBlock FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" Text="В плейлист" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="4,6"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Visibility="{Binding ShowInQuickPlaylistBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:LucideIcon Kind="check" Size="16" />
                                <TextBlock FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" Text="В плейлисте" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="AnnouncementListViewModern"
                        Grid.Row="3"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedAnnouncement, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource ModernSelectableListViewItemStyle}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16,10,16,10" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <icons:LucideIcon
                                        Kind="pin"
                                        Size="14"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="15"
                                        VerticalAlignment="Center"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource ModernSlideColumnBackgroundBrush}" Padding="28,22,24,16">
                <Grid>
                    <TextBlock
                        Margin="0,8"
                        FontSize="16"
                        Foreground="{ThemeResource ModernMutedBrush}"
                        Text="Выберите объявление, чтобы увидеть слайды."
                        Visibility="{Binding SelectedAnnouncement, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                    <Grid Visibility="{Binding SelectedAnnouncement, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18" Spacing="6">
                            <TextBlock
                                FontSize="36"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Text="{Binding SelectedAnnouncement.Title}" />
                            <TextBlock
                                FontSize="16"
                                Foreground="{ThemeResource ModernMutedBrush}"
                                Text="Слайды" />
                        </StackPanel>
                        <Grid x:Name="ModernSlideHost" Grid.Row="1">
                            <ListView
                                x:Name="SlideListModern"
                                anim:ItemListAppearance.UseCrossfade="True"
                                ItemsSource="{Binding SlidesPreview}"
                                SelectedItem="{Binding SelectedSlidePreview, Mode=TwoWay}"
                                SelectionMode="Single"
                                ItemContainerStyle="{StaticResource ModernSelectableListViewItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="22,16,20,16" Spacing="8">
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{ThemeResource ModernMutedBrush}"
                                                Text="{Binding Title}" />
                                            <TextBlock
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                LineHeight="30"
                                                TextWrapping="Wrap"
                                                Text="{Binding Content}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Rectangle
                                x:Name="ModernSlideStripe"
                                Width="3"
                                Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Fill="{ThemeResource ModernAccentBrush}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource ModernSurfaceBrush}" Padding="20,18,20,16">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Предпросмотр экрана" />
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                        <Grid x:Name="AnnouncementPreviewCanvas" Width="1920" Height="1080" Background="Black">
                            <icons:WebProjectionPreview x:Name="AnnouncementWebPreview" />
                            <TextBlock
                                x:Name="AnnouncementPreviewIdleHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="48"
                                Foreground="{ThemeResource ModernPreviewIdleForegroundBrush}"
                                Text="Выберите слайд"
                                Visibility="Collapsed" />
                        </Grid>
                    </Viewbox>
                    <Button
                        Margin="0,16,0,0"
                        Height="48"
                        HorizontalAlignment="Stretch"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Content="Показать на экране"
                        Command="{Binding StartProjectionCommand}"
                        Background="{ThemeResource ModernAccentBrush}"
                        Foreground="White"
                        BorderBrush="{ThemeResource ModernAccentBrush}"
                        CornerRadius="0"
                        IsEnabled="{Binding HasSelectedAnnouncement}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
