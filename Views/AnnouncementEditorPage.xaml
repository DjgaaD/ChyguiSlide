<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.AnnouncementEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ChyguiSlide.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel
                Padding="24"
                Spacing="16"
                HorizontalAlignment="Stretch">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Объявление" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Пустая строка между абзацами — новый слайд на экране."
                    TextWrapping="Wrap" />

                <TextBox
                    Header="Заголовок"
                    PlaceholderText="Например: Собрание молодёжи"
                    HorizontalAlignment="Stretch"
                    Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    Header="Текст"
                    PlaceholderText="Текст объявления"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="280"
                    HorizontalAlignment="Stretch"
                    Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox
                    Content="Закрепить вверху списка"
                    IsChecked="{Binding IsPinned, Mode=TwoWay}" />
            </StackPanel>
        </ScrollViewer>

        <Grid
            Visibility="{Binding IsValidationVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            Background="#99000000">
            <Border
                MaxWidth="440"
                MinWidth="320"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{Binding ValidationTitle}"
                        TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap" />
                    <Button
                        Content="OK"
                        HorizontalAlignment="Right"
                        MinWidth="88"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding DismissValidationCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
