<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:ChyguiSlide.Data.Entities"
    xmlns:converters="using:ChyguiSlide.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:ChyguiSlide.ViewModels"
    xmlns:icons="using:ChyguiSlide.Controls"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Margin="24,16,24,16" RowSpacing="12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        </Grid.Resources>

        <!-- Верхняя панель на всю ширину: заголовок, поиск, сборник, действия -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="12"
            Padding="16">
            <StackPanel Spacing="12">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Песни" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        PlaceholderText="Поиск по названию или тексту…"
                        QuerySubmitted="OnSearchBoxQuerySubmitted"
                        TextChanged="OnSearchBoxTextChanged" />

                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Сборник"
                        ItemsSource="{Binding CollectionFilters}"
                        SelectedItem="{Binding SelectedCollectionFilter, Mode=TwoWay}"
                        DisplayMemberPath="Title" />
                </Grid>

                <!-- Все действия в одну строку -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="arrow-up-down" Size="16" />
                            <TextBlock Text="Сортировка" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="По названию" Click="OnSortByTitleClicked" />
                                <MenuFlyoutItem Text="По номеру" Click="OnSortByNumberClicked" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Не в плейлисте -->
                    <Button
                        Click="OnAddToQuickPlaylistClicked"
                        Command="{Binding AddToQuickPlaylistCommand}"
                        Visibility="{Binding ShowAddToQuickPlaylistButton, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="list" Size="16" />
                            <TextBlock Text="В плейлист" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Уже добавлена -->
                    <Button
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding ShowInQuickPlaylistBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="check" Size="16" />
                            <TextBlock Text="В плейлисте" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <DropDownButton>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="plus" Size="16" />
                            <TextBlock Text="Добавить песню" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Набрать вручную" Click="OnCreateSongClicked" />
                                <MenuFlyoutItem Text="Импорт презентации" Click="OnImportSongClicked" />
                                <MenuFlyoutItem Text="Импорт с сайта" Click="OnImportFromUrlClicked" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <DropDownButton
                        Visibility="{Binding IsAllSongsFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="folder" Size="16" />
                            <TextBlock Text="Создать сборник" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Создать вручную" Click="OnCreateCollectionClicked" />
                                <MenuFlyoutItem Text="Импорт SPS" Click="OnImportSpsClicked" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button
                        Click="OnEditSongClicked"
                        IsEnabled="{Binding HasSelectedSong}"
                        Visibility="{Binding HasSelectedSong, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="pencil" Size="16" />
                            <TextBlock Text="Изменить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="OnDeleteSongClicked"
                        IsEnabled="{Binding HasSelectedSong}"
                        Visibility="{Binding HasSelectedSong, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="trash-2" Size="16" />
                            <TextBlock Text="Удалить песню" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Click="OnDeleteCollectionClicked"
                        Visibility="{Binding IsSpecificCollectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="trash-2" Size="16" />
                            <TextBlock Text="Удалить сборник" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="OnExpandChorusInCollectionClicked"
                        Visibility="{Binding IsSpecificCollectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:LucideIcon Kind="form" Size="16" />
                            <TextBlock Text="Припев после куплетов" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ProgressRing
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        IsActive="{Binding IsBusy}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Список песен -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="12">
            <ListView
                x:Name="SongListView"
                Margin="8"
                ItemsSource="{Binding Songs}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{ThemeResource StrokeColorDefaultBrush}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4"
                                Visibility="{Binding Number, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="№" />
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Number}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Детали песни -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="12">
            <Grid Margin="16">
                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Выберите песню, чтобы увидеть детали."
                    Visibility="{Binding SelectedSong, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />

                <Grid Visibility="{Binding SelectedSong, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center"
                        Margin="0,0,0,12">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{Binding SelectedSong.Title}" />
                        <Button
                            Content="Показать на экране"
                            HorizontalAlignment="Left"
                            Command="{Binding StartProjectionCommand}" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{Binding SectionsPreview}"
                        SelectedItem="{Binding SelectedSectionPreview, Mode=TwoWay}"
                        SelectionMode="Single"
                        ItemContainerStyle="{StaticResource SelectableCardListViewItemStyle}"
                        ItemTemplate="{StaticResource SelectableCardSelectedTemplate}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
