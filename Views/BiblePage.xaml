<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.BiblePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ChyguiSlide.Converters"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

            <Style x:Key="BibleTileItemStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverOverlay.Opacity" Value="0.12" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverOverlay.Opacity" Value="0.18" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionChrome.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="SelectionOverlay.Opacity" Value="0.42" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionChrome.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="SelectionOverlay.Opacity" Value="0.48" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.08" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionChrome.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="SelectionOverlay.Opacity" Value="0.52" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.12" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionChrome.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="SelectionOverlay.Opacity" Value="0.48" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.08" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionChrome.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="SelectionOverlay.Opacity" Value="0.52" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.12" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionChrome.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionChrome.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="SelectionOverlay.Opacity" Value="0.42" />
                                                <Setter Target="SelectionChrome.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- Толщина рамки всегда 4 — размер плитки не прыгает при выборе -->
                                <Border
                                    x:Name="SelectionChrome"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="4"
                                    CornerRadius="8">
                                    <Grid>
                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        <Border
                                            x:Name="SelectionOverlay"
                                            Background="White"
                                            CornerRadius="5"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                        <Border
                                            x:Name="HoverOverlay"
                                            Background="White"
                                            CornerRadius="5"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Библия" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding TranslationName}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ProgressRing
                    Width="24"
                    Height="24"
                    IsActive="{Binding IsBusy}" />
                <Button
                    Content="Показать на экране"
                    Command="{Binding StartProjectionCommand}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Режим списков -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12"
            Visibility="{Binding IsListPickerLayout, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding TestamentFilterItems}"
                        SelectedItem="{Binding SelectedTestamentFilter, Mode=TwoWay}"
                        DisplayMemberPath="Title" />
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Row="1"
                        PlaceholderText="2пар 15 8 · Екк 11 10 · текст…"
                        QuerySubmitted="OnSearchSubmitted"
                        TextChanged="OnSearchTextChanged" />
                    <ListView
                        Grid.Row="2"
                        ItemsSource="{Binding Books}"
                        SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="4,6"
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="Глава"
                        HorizontalAlignment="Center" />
                    <ListView
                        x:Name="ChapterList"
                        Grid.Row="1"
                        ItemsSource="{Binding Chapters}"
                        SelectionChanged="OnChapterSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="8">
                <Grid>
                    <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="8,4"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{Binding SelectionSummary}" />
                        <ListView
                            x:Name="VerseList"
                            Grid.Row="1"
                            ItemsSource="{Binding Verses}"
                            SelectedItem="{Binding SelectedVerse, Mode=TwoWay}"
                            SelectionMode="Single"
                            ItemContainerStyle="{StaticResource SelectableCardListViewItemStyle}"
                            ItemTemplate="{StaticResource SelectableCardSelectedTemplate}" />
                    </Grid>

                    <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="8,4"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Результаты поиска" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding SearchResults}"
                            SelectionChanged="OnSearchResultSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Padding="4,6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Reference}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Режим плиток -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12"
            Visibility="{Binding IsGridPickerLayout, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="380" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="8">
                <Grid>
                    <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="8,4"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{Binding SelectionSummary}" />
                        <ListView
                            x:Name="GridVerseTextList"
                            Grid.Row="1"
                            ItemsSource="{Binding Verses}"
                            SelectedItem="{Binding SelectedVerse, Mode=TwoWay}"
                            SelectionMode="Single"
                            ItemContainerStyle="{StaticResource SelectableCardListViewItemStyle}"
                            ItemTemplate="{StaticResource SelectableCardSelectedTemplate}" />
                    </Grid>

                    <Grid Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="8,4"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Результаты поиска" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding SearchResults}"
                            SelectionChanged="OnSearchResultSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Padding="4,6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Reference}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.15*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="GridSearchBox"
                        PlaceholderText="2пар 15 8 · Екк 11 10 · текст…"
                        QuerySubmitted="OnSearchSubmitted"
                        TextChanged="OnSearchTextChanged" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding TestamentFilterItems}"
                        SelectedItem="{Binding SelectedTestamentFilter, Mode=TwoWay}"
                        DisplayMemberPath="Title" />
                </Grid>

                <Border
                    x:Name="BookGridHost"
                    Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="12"
                    Padding="8"
                    SizeChanged="OnPickerGridSizeChanged">
                    <GridView
                        x:Name="BookGrid"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ItemsSource="{Binding Books}"
                        SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                        SelectionMode="Single"
                        SizeChanged="OnPickerGridSizeChanged"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ItemContainerStyle="{StaticResource BibleTileItemStyle}">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="11" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{Binding CategoryColorHex, Converter={StaticResource HexToBrushConverter}}"
                                    CornerRadius="6"
                                    Padding="3">
                                    <Viewbox
                                        Stretch="Uniform"
                                        StretchDirection="Both"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Margin="8">
                                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="28"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding Abbreviation}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="#E6FFFFFF"
                                                Text="{Binding RussianName}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                        </StackPanel>
                                    </Viewbox>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="ChapterGridHost"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="8"
                        SizeChanged="OnPickerGridSizeChanged">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Глава" />
                            <GridView
                                x:Name="ChapterGrid"
                                Grid.Row="1"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ItemsSource="{Binding Chapters}"
                                SelectionChanged="OnChapterGridSelectionChanged"
                                SelectionMode="Single"
                                SizeChanged="OnPickerGridSizeChanged"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ItemContainerStyle="{StaticResource BibleTileItemStyle}">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid MaximumRowsOrColumns="10" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Background="#8B6B3D"
                                            CornerRadius="6"
                                            Padding="2">
                                            <Viewbox
                                                Stretch="Uniform"
                                                StretchDirection="Both"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="8">
                                                <TextBlock
                                                    FontSize="32"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Text="{Binding}" />
                                            </Viewbox>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="VerseGridHost"
                        Grid.Column="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="8"
                        SizeChanged="OnPickerGridSizeChanged">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Стих" />
                            <GridView
                                x:Name="VerseNumberGrid"
                                Grid.Row="1"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ItemsSource="{Binding Verses}"
                                SelectedItem="{Binding SelectedVerse, Mode=TwoWay}"
                                SelectionMode="Single"
                                SizeChanged="OnPickerGridSizeChanged"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ItemContainerStyle="{StaticResource BibleTileItemStyle}">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid MaximumRowsOrColumns="8" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Background="#C4A574"
                                            CornerRadius="6"
                                            Padding="2">
                                            <Viewbox
                                                Stretch="Uniform"
                                                StretchDirection="Both"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="8">
                                                <TextBlock
                                                    FontSize="32"
                                                    FontWeight="Bold"
                                                    Foreground="#1A1208"
                                                    Text="{Binding VerseNumber}" />
                                            </Viewbox>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
