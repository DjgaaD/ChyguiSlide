<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ChyguiSlide.Views.LiveControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:ChyguiSlide.ViewModels"
    xmlns:converters="using:ChyguiSlide.Converters"
    xmlns:icons="using:ChyguiSlide.Controls"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <converters:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <converters:BoolToNdiStatusConverter x:Key="BoolToNdiStatusConverter" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: превью, быстрый и сохранённые плейлисты -->
        <StackPanel Grid.Column="0" Margin="16" Spacing="12">
            <!-- Предпросмотр: зеркало экрана проекции -->
            <Grid Height="200">
                <Viewbox
                    Stretch="Uniform"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <Grid
                        Width="1920"
                        Height="1080"
                        Background="Black">
                        <Grid x:Name="PreviewStageHost" />
                    </Grid>
                </Viewbox>
                <TextBlock
                    x:Name="PreviewIdleHint"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Нет сигнала"
                    Visibility="Collapsed" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Width="40"
                    Height="40"
                    Padding="4"
                    Click="OnSaveQuickPlaylistClick"
                    ToolTipService.ToolTip="Сохранить быстрый плейлист">
                    <icons:LucideIcon Kind="save" Size="18" />
                </Button>
                <Button
                    Width="40"
                    Height="40"
                    Padding="4"
                    Click="OnClearQuickPlaylistClick"
                    ToolTipService.ToolTip="Сбросить быстрый плейлист">
                    <icons:LucideIcon Kind="refresh-cw" Size="18" />
                </Button>
                <Button
                    Content="Начать показ"
                    Command="{Binding OpenProjectionCommand}"
                    Click="OnOpenProjectionClick"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{Binding IsShowStarted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
            </StackPanel>

            <!-- Блок 1: Быстрый плейлист -->
            <Border
                BorderBrush="{ThemeResource StrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Padding="12" Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Быстрый плейлист" />
                    <ListView
                        x:Name="QuickPlaylistList"
                        ItemsSource="{Binding QuickEntries}"
                        SelectedItem="{Binding SelectedQuickEntry, Mode=TwoWay}"
                        SelectionMode="Single"
                        CanReorderItems="True"
                        CanDragItems="True"
                        AllowDrop="True"
                        DragItemsCompleted="OnQuickPlaylistDragItemsCompleted">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{ThemeResource StrokeColorDefaultBrush}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <icons:LucideIcon
                                        Grid.Column="0"
                                        Kind="grip-vertical"
                                        Size="16"
                                        VerticalAlignment="Center"
                                        Opacity="0.45"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        ToolTipService.ToolTip="Перетащить" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Opacity="{Binding WasPlayed, Converter={StaticResource BoolToDimOpacityConverter}}"
                                        Text="{Binding Song.Title}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Блок 2: Сохранённые плейлисты -->
            <Border
                BorderBrush="{ThemeResource StrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Padding="12" Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Сохранённые плейлисты" />
                    <ListView
                        ItemsSource="{Binding SavedPlaylists}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnSavedPlaylistItemClick"
                        ItemContainerStyle="{StaticResource SelectableCardHoverOnlyListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="{Binding Location}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Padding="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Click="OnDeleteSavedPlaylistClick"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Удалить плейлист">
                                        <icons:LucideIcon Kind="trash-2" Size="16" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Правая колонка: управление трансляцией -->
        <Grid Grid.Column="1" Margin="8,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Padding="16,0,16,12" Spacing="8">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{Binding CurrentState.SongTitle, FallbackValue='Нет активной песни'}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock FontWeight="SemiBold" Text="{Binding SongProgressLabel}" />
                    <TextBlock Text="{Binding SectionProgressLabel}" />
                </StackPanel>
            </StackPanel>

            <!-- Секции -->
            <Grid Grid.Row="1" Padding="16,0,8,0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Секции песни" />
                <ListView
                    x:Name="SectionList"
                    Grid.Row="1"
                    ItemsSource="{Binding Sections}"
                    SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                    SelectionMode="Single"
                    ItemContainerStyle="{StaticResource SelectableCardListViewItemStyle}"
                    ItemTemplate="{StaticResource SelectableCardCurrentTemplate}" />
            </Grid>

            <!-- Панель управления -->
            <Grid Grid.Row="2" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Content="◄ Предыдущая"
                            Command="{Binding ShowPreviousCommand}"
                            Style="{StaticResource PrimaryAction}" />
                        <Button
                            Content="Следующая ►"
                            Command="{Binding ShowNextCommand}"
                            Style="{StaticResource PrimaryAction}" />
                        <Button
                            Content="Очистить"
                            Command="{Binding ClearProjectionCommand}" />
                    </StackPanel>
                    
                    <!-- NDI настройки -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{Binding IsProjectionWindowOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="NDI источник:"
                            Visibility="{Binding IsNdiModeActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ComboBox
                            Width="250"
                            ItemsSource="{Binding AvailableNdiSources}"
                            SelectedItem="{Binding SelectedNdiSource, Mode=TwoWay}"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding IsLoadingNdiSources, Converter={StaticResource BoolNegationConverter}}"
                            Visibility="{Binding IsNdiModeActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="11"
                                            Text="{Binding IpAddress}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            Width="40"
                            Height="40"
                            Padding="4"
                            Command="{Binding RefreshNdiSourcesCommand}"
                            ToolTipService.ToolTip="Обновить список доступных NDI источников"
                            Visibility="{Binding IsNdiModeActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <icons:LucideIcon Kind="refresh-cw" Size="18" />
                        </Button>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{Binding IsNdiModeActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{Binding IsNdiConnected, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding IsNdiConnected, Converter={StaticResource BoolToNdiStatusConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button
                        Content="Закрыть проектор"
                        Command="{Binding CloseProjectionCommand}"
                        Visibility="{Binding IsProjectionWindowOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Content="Камера"
                        Command="{Binding ToggleVideoModeCommand}"
                        ToolTipService.ToolTip="Переключить между текстом и видео с камеры"
                        Visibility="{Binding IsProjectionWindowOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Content="NDI"
                        Command="{Binding ToggleNdiVideoModeCommand}"
                        ToolTipService.ToolTip="Переключить на NDI видеопоток"
                        Visibility="{Binding IsProjectionWindowOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
